# Development Environment Configuration

# Environment
REACT_APP_ENV=development

# Proxy configuration
REACT_APP_USE_PROXY=true
REACT_APP_PROXY_URL=http://localhost:8080

# API URLs
REACT_APP_AUTH_API_URL=https://dev.auth.spatialmods.com
REACT_APP_MAIN_API_URL=https://dev.net-api.spatialmods.com


# Analytics configuration
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_POSTHOG_API_KEY=your_posthog_api_key
REACT_APP_POSTHOG_HOST=https://app.posthog.com
REACT_APP_SENTRY_DSN=your_sentry_dsn
REACT_APP_ANALYTICS_SAMPLE_RATE=1.0