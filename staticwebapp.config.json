{
  "routes": [
    {
      "route": "/main-api",
      "methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allowedRoles": [
        "authenticated"
      ],
      "rewrite": "https://dev.net-api.spatialmods.com"
    },
    {
      "route": "/main-api/*",
      "methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allowedRoles": [
        "authenticated"
      ],
      "rewrite": "https://dev.net-api.spatialmods.com/{path}"
    },
    {
      "route": "/auth-api/*",
      "methods": [
        "get",
        "post",
        "put",
        "delete",
        "options"
      ],
      "redirect": "https://dev.auth.spatialmods.com/{*}",
      "statusCode": 302,
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/test",
      "methods": [
        "get"
      ],
      "redirect": "https://dev.net-api.spatialmods.com/swagger/index.html",
      "statusCode": 301,
      "allowedRoles": [
        "anonymous"
      ]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*.{png,jpg,gif}",
      "/css/*",
      "/js/*",
      "/api/*"
    ]
  },
  "responseOverrides": {
    "401": {
      "redirect": "/login",
      "statusCode": 302
    },
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
    "Access-Control-Allow-Headers": "content-type, authorization, x-requested-with"
  },
  "platform": {
    "apiRuntime": "node:18",
    "staticWebAppsClientLogging": {
      "clientRequestEnabled": true,
      "clientRequestLevel": "verbose"
    }
  },
  "mimeTypes": {
    ".json": "application/json",
    ".css": "text/css",
    ".js": "text/javascript",
    ".html": "text/html"
  }
}